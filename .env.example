OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin
PORT=8787
ALLOWED_ORIGIN=http://localhost:5173
VITE_REALTIME_TOKEN_URL=/api/token
VITE_SESSION_SAVE_URL=/api/sessions
VITE_RECENT_WORLDS_URL=/api/worlds/recent
OPENAI_SUMMARY_MODEL=gpt-5.4-mini
SUPABASE_URL=https://your-project.supabase.co
# Vercel/Supabase templates sometimes name the same value NEXT_PUBLIC_SUPABASE_URL.
# The server accepts either SUPABASE_URL or NEXT_PUBLIC_SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
